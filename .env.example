# Copie este arquivo para .env e preencha os valores
MEDIA_SERIES_DIR=C:\Caminho\Para\Series
MEDIA_MOVIES_DIR=C:\Caminho\Para\Filmes
HOST=0.0.0.0
PORT=80
TMDB_API_READ_TOKEN=seu_token_aqui

# Telegram (sugestões)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Certificados Tizen (usados por StreamingTV/deploy-tools/resign_wgt.py)
# O script lê direto do ambiente — exporte estas variáveis antes de rodá-lo
TIZEN_AUTHOR_P12=C:\Caminho\Para\author.p12
TIZEN_DIST_P12=C:\Caminho\Para\distributor.p12
TIZEN_AUTHOR_PWD=senha_do_certificado
TIZEN_DIST_PWD=senha_do_certificado